FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_LOGO_DEV_PUBLISHABLE_KEY=""
RUN node -e 'const key = process.env.VITE_LOGO_DEV_PUBLISHABLE_KEY || ""; if (key && !key.startsWith("pk_")) throw new Error("Logo.dev requires a publishable pk_ key");' \
    && npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile.frontend /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
