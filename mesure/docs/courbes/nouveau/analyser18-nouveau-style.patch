 import matplotlib
 matplotlib.use("Agg")
 import matplotlib.pyplot as plt
+from matplotlib.ticker import MaxNLocator
 
 from etalonnage import ROOT, digest, save
 from verifier17 import main as verify
 
 
+STYLES = {"vm": ("#2563a6", "o", "VM"), "docker": ("#ce6a13", "s", "Docker")}
+METRICS = (("successful_throughput_rps", "Débit réussi", "consultations/s", "debit"),
+           ("p95_ms", "Latence au 95e centile", "ms", "latence-p95"),
+           ("error_pct", "Erreurs dans la fenêtre stable", "%", "erreurs"))
+MUTED = "#4b5563"
+
+
+def tracer(runs, users, charts):
+    """Draw both repetitions per deployment: the throughput/p95 pair, then one file per metric."""
+    plt.rcParams.update({"axes.spines.top": False, "axes.spines.right": False,
+                         "axes.edgecolor": "#9ca3af", "axes.labelcolor": MUTED,
+                         "xtick.color": MUTED, "ytick.color": MUTED, "font.size": 10})
+    worst_error = max(run["error_pct"] for run in runs.values())
+    errors = ("Aucune erreur dans les fenêtres stables." if worst_error == 0
+              else f"Erreurs : jusqu'à {worst_error:g} % dans les fenêtres stables.")
+    note = (f"{errors} "
+            f"Paliers de {users[0]} à {users[-1]} utilisateurs ; les deux répétitions restent séparées.")
+
+    def plot(ax, metric, title, unit):
+        for dep, (color, marker, name) in STYLES.items():
+            for series in (1, 2):
+                ax.plot(users, [runs[series, dep, n][metric] for n in users], color=color,
+                        marker=marker, markersize=6, markeredgewidth=1.5, linewidth=2,
+                        markerfacecolor=color if series == 1 else "white",
+                        linestyle="-" if series == 1 else "--", label=f"{name}, série {series}")
+        if metric == "successful_throughput_rps":
+            ax.plot(users, users, color="#9ca3af", linestyle=":", linewidth=1.5, zorder=0,
+                    label="Plafond du profil (U / 1 s)")
+        if metric == "error_pct":
+            ax.set_ylim(-0.1, 1)
+        else:
+            ax.set_ylim(bottom=0)
+            ax.yaxis.set_major_locator(MaxNLocator(nbins=5, steps=[1, 2, 5, 10], integer=True))
+        ax.set_title(title, loc="left", fontsize=11, weight="bold", color="#111827")
+        ax.set(xlabel="Utilisateurs simultanés", ylabel=unit, xticks=users)
+        ax.grid(axis="y", color="#e5e7eb", linewidth=.8)
+        ax.set_axisbelow(True)
+
+    def legend(fig, ax):
+        fig.legend(*ax.get_legend_handles_labels(), loc="outside upper center", ncols=5,
+                   frameon=False, fontsize=9)
+
+    fig, axes = plt.subplots(1, 2, figsize=(10, 4.4), layout="constrained")
+    for ax, (metric, title, unit, _) in zip(axes, METRICS):
+        plot(ax, metric, title, unit)
+    legend(fig, axes[0])
+    fig.supxlabel(note, fontsize=9, color=MUTED)
+    fig.savefig(charts / "ensemble.png", dpi=180)
+    fig.savefig(charts / "ensemble.pdf")
+    plt.close(fig)
+
+    for metric, title, unit, name in METRICS:
+        standalone, ax = plt.subplots(figsize=(8, 4.4), layout="constrained")
+        plot(ax, metric, title, unit)
+        legend(standalone, ax)
+        standalone.supxlabel(note, fontsize=9, color=MUTED)
+        for extension in ("png", "svg"):
+            path = charts / f"{name}.{extension}"
+            standalone.savefig(path, dpi=180)
+            if extension == "svg":
+                path.write_text("\n".join(line.rstrip() for line in path.read_text().splitlines()) + "\n")
+        plt.close(standalone)
+
+
 def main():
