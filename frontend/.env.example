# Optional: direct CDN fallback for companies with a verified domain.
# Use a publishable pk_ key, never an sk_ secret. No key = no third-party requests.
# Docker deployment: set this in the root .env.production and rebuild frontend.
VITE_LOGO_DEV_PUBLISHABLE_KEY=
# Chemin de l'API sur la même origine (par défaut : /api/v1).
VITE_API_ROOT=/api/v1
